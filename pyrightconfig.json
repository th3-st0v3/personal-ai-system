{
  "typeCheckingMode": "basic",
  "include": ["src", "scripts"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/.tox",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/dist",
    "**/build",
    "**/site-packages/**",
    "**/.*"
  ],
  "reportMissingModuleSource": "none"
}
