{
  "typeCheckingMode": "basic",
  "include": ["src", "scripts"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/.tox",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.*",
    "src/test_*.py",
    "src/web_api.py",
    "src/engineering_web_api.py"
  ],
  "reportMissingModuleSource": "none"
}
