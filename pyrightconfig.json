{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.14",
  "include": [
    "src",
    "scripts",
    "automation/orchestrator"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/.tox",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/dist",
    "**/build",
    "**/site-packages/**",
    "**/.*"
  ],
  "extraPaths": [
    "src"
  ],
  "reportMissingModuleSource": "none"
}