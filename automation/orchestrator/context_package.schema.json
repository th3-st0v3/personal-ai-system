{
  "$defs": {
    "AgentRequest": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "expected_output": {
          "items": {
            "type": "string"
          },
          "title": "Expected Output",
          "type": "array"
        },
        "restrictions": {
          "items": {
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        }
      },
      "required": [
        "task"
      ],
      "title": "AgentRequest",
      "type": "object"
    },
    "AttemptResult": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "fact",
            "hypothesis",
            "verified",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "title": "AttemptResult",
      "type": "object"
    },
    "BrowserContext": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserPageContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/BrowserControl"
          },
          "title": "Controls",
          "type": "array"
        },
        "visible_errors": {
          "items": {
            "type": "string"
          },
          "title": "Visible Errors",
          "type": "array"
        },
        "runtime_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserRuntimeState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "available"
      ],
      "title": "BrowserContext",
      "type": "object"
    },
    "BrowserControl": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "control": {
          "minLength": 1,
          "title": "Control",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        }
      },
      "required": [
        "id",
        "control"
      ],
      "title": "BrowserControl",
      "type": "object"
    },
    "BrowserPageContext": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "title": "BrowserPageContext",
      "type": "object"
    },
    "BrowserRuntimeState": {
      "additionalProperties": false,
      "properties": {
        "loading": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loading"
        }
      },
      "title": "BrowserRuntimeState",
      "type": "object"
    },
    "BuildContext": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "not_run",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        }
      },
      "required": [
        "status"
      ],
      "title": "BuildContext",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "authorized": {
          "default": false,
          "title": "Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Capability",
      "type": "object"
    },
    "DiffSummary": {
      "additionalProperties": false,
      "properties": {
        "files_changed": {
          "minimum": 0,
          "title": "Files Changed",
          "type": "integer"
        },
        "insertions": {
          "minimum": 0,
          "title": "Insertions",
          "type": "integer"
        },
        "deletions": {
          "minimum": 0,
          "title": "Deletions",
          "type": "integer"
        }
      },
      "required": [
        "files_changed",
        "insertions",
        "deletions"
      ],
      "title": "DiffSummary",
      "type": "object"
    },
    "EvidenceQuality": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "default": "unknown",
          "enum": [
            "poor",
            "fair",
            "good",
            "strong",
            "unknown"
          ],
          "title": "Overall",
          "type": "string"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "stale": {
          "items": {
            "type": "string"
          },
          "title": "Stale",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "title": "EvidenceQuality",
      "type": "object"
    },
    "ExcludedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "ExcludedFile",
      "type": "object"
    },
    "ExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "approval_required": {
          "items": {
            "type": "string"
          },
          "title": "Approval Required",
          "type": "array"
        }
      },
      "title": "ExecutionPolicy",
      "type": "object"
    },
    "FilesContext": {
      "additionalProperties": false,
      "properties": {
        "relevant": {
          "items": {
            "$ref": "#/$defs/RelevantFile"
          },
          "title": "Relevant",
          "type": "array"
        },
        "excluded": {
          "items": {
            "$ref": "#/$defs/ExcludedFile"
          },
          "title": "Excluded",
          "type": "array"
        }
      },
      "title": "FilesContext",
      "type": "object"
    },
    "GitWslContext": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "head": {
          "minLength": 1,
          "title": "Head",
          "type": "string"
        },
        "upstream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream"
        },
        "sync_state": {
          "enum": [
            "SYNCED",
            "LOCAL_AHEAD",
            "REMOTE_AHEAD",
            "DIVERGED",
            "DIRTY_LOCAL",
            "UNKNOWN"
          ],
          "title": "Sync State",
          "type": "string"
        },
        "working_tree": {
          "$ref": "#/$defs/WorkingTreeContext"
        },
        "ahead": {
          "minimum": 0,
          "title": "Ahead",
          "type": "integer"
        },
        "behind": {
          "minimum": 0,
          "title": "Behind",
          "type": "integer"
        },
        "recent_commits": {
          "items": {
            "type": "string"
          },
          "title": "Recent Commits",
          "type": "array"
        },
        "diff_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "branch",
        "head",
        "sync_state",
        "working_tree",
        "ahead",
        "behind"
      ],
      "title": "GitWslContext",
      "type": "object"
    },
    "MemoryContext": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "obsidian",
          "default": "obsidian",
          "title": "Source",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/MemoryNote"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "query"
      ],
      "title": "MemoryContext",
      "type": "object"
    },
    "MemoryNote": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "relevance",
        "content"
      ],
      "title": "MemoryNote",
      "type": "object"
    },
    "ObjectiveContext": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "minLength": 1,
          "title": "Primary",
          "type": "string"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Success Criteria",
          "type": "array"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high",
            "critical"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "primary"
      ],
      "title": "ObjectiveContext",
      "type": "object"
    },
    "PreviousAttempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "result": {
          "minLength": 1,
          "title": "Result",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "success",
            "failed",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/AttemptResult"
          },
          "title": "Conclusions",
          "type": "array"
        }
      },
      "required": [
        "attempt_id",
        "objective",
        "action",
        "result"
      ],
      "title": "PreviousAttempt",
      "type": "object"
    },
    "ProjectContext": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryContext"
        }
      },
      "required": [
        "project_id",
        "name",
        "repository"
      ],
      "title": "ProjectContext",
      "type": "object"
    },
    "RelevantFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance",
          "type": "number"
        }
      },
      "required": [
        "path",
        "reason",
        "relevance"
      ],
      "title": "RelevantFile",
      "type": "object"
    },
    "RepositoryContext": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "branch": {
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "repository",
        "branch"
      ],
      "title": "RepositoryContext",
      "type": "object"
    },
    "ResearchContext": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "title": "Observations",
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "sources_considered": {
          "items": {
            "type": "string"
          },
          "title": "Sources Considered",
          "type": "array"
        },
        "unanswered_questions": {
          "items": {
            "type": "string"
          },
          "title": "Unanswered Questions",
          "type": "array"
        },
        "evidence_quality": {
          "default": "unknown",
          "enum": [
            "poor",
            "fair",
            "good",
            "strong",
            "unknown"
          ],
          "title": "Evidence Quality",
          "type": "string"
        }
      },
      "required": [
        "objective"
      ],
      "title": "ResearchContext",
      "type": "object"
    },
    "TestContext": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "not_run",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "frameworks": {
          "items": {
            "type": "string"
          },
          "title": "Frameworks",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/TestSummary"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/TestFailure"
          },
          "title": "Failures",
          "type": "array"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "title": "TestContext",
      "type": "object"
    },
    "TestFailure": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "traceback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceback"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "name"
      ],
      "title": "TestFailure",
      "type": "object"
    },
    "TestSummary": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "skipped",
        "errors"
      ],
      "title": "TestSummary",
      "type": "object"
    },
    "WorkingTreeContext": {
      "additionalProperties": false,
      "properties": {
        "clean": {
          "title": "Clean",
          "type": "boolean"
        },
        "changed_files": {
          "items": {
            "type": "string"
          },
          "title": "Changed Files",
          "type": "array"
        }
      },
      "required": [
        "clean"
      ],
      "title": "WorkingTreeContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "objective": {
      "$ref": "#/$defs/ObjectiveContext"
    },
    "project": {
      "$ref": "#/$defs/ProjectContext"
    },
    "memory": {
      "$ref": "#/$defs/MemoryContext"
    },
    "git_wsl": {
      "$ref": "#/$defs/GitWslContext"
    },
    "tests": {
      "$ref": "#/$defs/TestContext"
    },
    "research": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "browser": {
      "$ref": "#/$defs/BrowserContext"
    },
    "files": {
      "$ref": "#/$defs/FilesContext"
    },
    "previous_attempts": {
      "items": {
        "$ref": "#/$defs/PreviousAttempt"
      },
      "title": "Previous Attempts",
      "type": "array"
    },
    "available_capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Available Capabilities",
      "type": "array"
    },
    "execution_policy": {
      "$ref": "#/$defs/ExecutionPolicy"
    },
    "evidence_quality": {
      "$ref": "#/$defs/EvidenceQuality"
    },
    "agent_request": {
      "$ref": "#/$defs/AgentRequest"
    }
  },
  "required": [
    "context_id",
    "created_at",
    "objective",
    "project",
    "memory",
    "git_wsl",
    "tests",
    "browser",
    "files",
    "execution_policy",
    "evidence_quality",
    "agent_request"
  ],
  "title": "ContextPackage",
  "type": "object"
}
