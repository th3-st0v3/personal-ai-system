{
  "manifest_version": 3,
  "name": "PASI ChatGPT Controller",
  "version": "1.1.1",
  "description": "Native Chromium controller and watchdog for Personal AI System ChatGPT automation.",
  "permissions": [
    "alarms",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Open PASI Control Center"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "timeout-policy.json"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "activity.js",
        "timeout-config.js",
        "detectors.js",
        "recovery_progress.js",
        "content.js",
        "recovery.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
