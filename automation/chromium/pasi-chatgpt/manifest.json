{
  "manifest_version": 3,
  "name": "PASI ChatGPT Controller",
  "version": "1.1.1",
  "description": "Native Chromium controller and watchdog for Personal AI System ChatGPT automation.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*"],
      "js": ["activity.js", "content.js", "recovery.js"],
      "run_at": "document_idle"
    }
  ]
}
