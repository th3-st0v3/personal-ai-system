{
  "manifest_version": 3,
  "minimum_chrome_version": "133",
  "name": "PASI ChatGPT Controller",
  "version": "1.2.0",
  "description": "Native Chromium controller, watchdog, and MV3 userscript runtime for Personal AI System.",
  "permissions": [
    "alarms",
    "storage",
    "sidePanel",
    "scripting",
    "userScripts"
  ],
  "optional_permissions": [
    "tabs",
    "contextMenus",
    "notifications",
    "downloads",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "timeout-policy.json"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "timeout-config.js",
        "detectors.js",
        "recovery_progress.js",
        "content.js",
        "recovery.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open PASI Control Center"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
